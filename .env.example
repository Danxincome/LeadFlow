# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Provider (Google Gemini — configure when ready)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Stripe (configure when ready)
STRIPE_SECRET_KEY=your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Stripe Price IDs — create these Products/Prices in the Stripe dashboard
# first, then paste their price IDs (price_...) here. Until set, the
# corresponding plan's checkout button will show a "not configured" error.
STRIPE_PRICE_STARTER=your-stripe-price-id-starter
STRIPE_PRICE_PROFESSIONAL=your-stripe-price-id-professional
STRIPE_PRICE_ENTERPRISE=your-stripe-price-id-enterprise

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
